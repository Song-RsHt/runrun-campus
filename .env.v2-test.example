# Local placeholders only. Run tools/initialize-v2-environment.ps1 after copying.
RRC_V2_JDBC_URL=jdbc:postgresql://postgres:5432/rrc_v2_test
RRC_V2_DB_USERNAME=rrc_v2_local
RRC_V2_DB_PASSWORD=REPLACE_LOCALLY
RRC_V2_ENVIRONMENT=test
RRC_IDENTITY_ENCRYPTION_KEY=REPLACE_LOCALLY
RRC_IDENTITY_HASH_KEY=REPLACE_LOCALLY
RRC_PAYMENT_MOCK_ENABLED=true
# Deliberately not a real telephone number; only this synthetic ID is accepted.
RRC_V2_ADMIN_PHONE=test-admin
RRC_V2_ADMIN_PASSWORD=REPLACE_LOCALLY
RRC_V2_BOOTSTRAP_CONFIRM=REPLACE_WITH_CREATE_ISOLATED_TEST_ADMIN
