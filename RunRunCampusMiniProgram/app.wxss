page {
  min-height: 100%;
  background: #f4f7f6;
  color: #16302d;
  font-size: 28rpx;
}

button {
  border-radius: 18rpx;
  font-weight: 600;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
}

.hero {
  margin-bottom: 28rpx;
  padding: 40rpx 34rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e, #115e59);
  box-shadow: 0 18rpx 48rpx rgba(15, 118, 110, 0.18);
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 750;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
}

.eyebrow {
  color: #99f6e4;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #e1ece9;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 36rpx rgba(15, 62, 56, 0.06);
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
  line-height: 1.6;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #34514d;
  font-weight: 650;
}

.input,
.picker,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid #d7e4e1;
  border-radius: 16rpx;
  background: #f8fbfa;
}

.input,
.picker {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 160rpx;
  padding: 22rpx 24rpx;
}

.primary {
  color: #ffffff;
  background: #0f766e;
}

.secondary {
  color: #0f766e;
  background: #e6f4f1;
}

.danger {
  color: #b42318;
  background: #feeceb;
}

.compact-button {
  display: inline-flex;
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  align-items: center;
  font-size: 26rpx;
  line-height: 64rpx;
}

.button-stack button + button {
  margin-top: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #dff4ef;
  font-size: 24rpx;
  font-weight: 650;
}

.tag-warn {
  color: #9a6700;
  background: #fff4ce;
}

.tag-neutral {
  color: #475569;
  background: #eef2f6;
}

.error {
  margin: 18rpx 0;
  color: #b42318;
  line-height: 1.5;
}

.empty {
  padding: 70rpx 24rpx;
  color: #64748b;
  text-align: center;
}

.loading {
  padding: 70rpx 24rpx;
  color: #0f766e;
  text-align: center;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e1ece9;
  border-radius: 22rpx;
  background: #ffffff;
}

.order-title {
  font-size: 31rpx;
  font-weight: 700;
}

.order-meta {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  line-height: 1.55;
}

.money {
  color: #0f766e;
  font-size: 34rpx;
  font-weight: 750;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e5ecea;
}
