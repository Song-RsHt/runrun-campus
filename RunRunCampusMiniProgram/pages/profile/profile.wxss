.profile-card {
  display: flex;
  margin: 28rpx 0;
  padding: 50rpx 30rpx;
  flex-direction: column;
  align-items: center;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e, #134e4a);
}

.avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  color: #0f766e;
  background: #ccfbf1;
  font-size: 46rpx;
  font-weight: 750;
}

.profile-name {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 750;
}

.profile-role {
  margin-top: 8rpx;
  color: #ccfbf1;
}

.detail-row {
  display: flex;
  padding: 22rpx 0;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf2f1;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-row text:first-child {
  color: #64748b;
}
