.header-row {
  margin: 12rpx 0 30rpx;
}

.dark-eyebrow {
  display: block;
  color: #0f766e;
}

.page-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 750;
}

.filter-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.filter-button {
  flex: 1;
  color: #64748b;
  background: #e8efed;
}

.filter-active {
  color: #ffffff;
  background: #0f766e;
}

.order-number {
  display: block;
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.route-line {
  display: block;
  margin: 4rpx 0 4rpx 12rpx;
  color: #0f766e;
}

.destination {
  color: #34514d;
}

.order-footer {
  margin-top: 22rpx;
}
