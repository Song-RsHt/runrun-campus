FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src src
RUN mvn -B -ntp -Pv2-identity -DskipTests package

FROM eclipse-temurin:17-jre-alpine
RUN addgroup -S runrun && adduser -S -G runrun runrun \
    && mkdir -p /app/evidence && chown runrun:runrun /app/evidence
WORKDIR /app
COPY --from=build /app/target/runrun-campus-backend-0.0.1-SNAPSHOT.jar /app/app.jar
USER runrun
EXPOSE 8082
ENTRYPOINT ["sh", "/scripts/backend-entrypoint.sh"]
