SPRING_DATASOURCE_URL=jdbc:postgresql://database-host:5432/runrun_campus?sslmode=verify-full&sslrootcert=/run/secrets/RDS_CA_CERTIFICATE
SPRING_DATASOURCE_USERNAME=replace-with-production-user
SPRING_DATASOURCE_PASSWORD_FILE=./secrets/production/database-password.txt
RDS_CA_CERTIFICATE_FILE=./secrets/production/rds-ca.pem
APP_ADMIN_PHONE=replace-with-admin-phone
APP_ADMIN_PASSWORD_FILE=./secrets/production/admin-password.txt
ADMIN_MFA_KEY_FILE=./secrets/admin-mfa/ADMIN_MFA_KEY
APP_ADMIN_DISPLAY_NAME=平台管理员
OSS_REGION=cn-heyuan
OSS_BUCKET=replace-with-private-bucket-name
OSS_ECS_ROLE_NAME=replace-with-ecs-ram-role-name
OSS_USE_INTERNAL_ENDPOINT=true
PUSH_ENABLED=false
PUSH_APP_KEY=replace-with-emas-android-app-key
PUSH_ECS_ROLE_NAME=replace-with-ecs-ram-role-name
PUSH_REGION=cn-hangzhou
PUSH_ENDPOINT=cloudpush.aliyuncs.com
PUSH_CHANNEL_ID=order_updates
PUSH_ACTIVITY=com.zhangxuan.runruncampus.MainActivity
ANDROID_UPDATE_VERSION_CODE=0
ANDROID_UPDATE_VERSION_NAME=
ANDROID_UPDATE_DOWNLOAD_URL=
MANUAL_QR_PAYMENT_ENABLED=false
APP_PORT=8080
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8
WECHAT_PAY_APP_ID=replace-with-wechat-open-platform-app-id
WECHAT_PAY_MERCHANT_ID=replace-with-wechat-pay-merchant-id
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=replace-with-merchant-certificate-serial-number
WECHAT_PAY_PRIVATE_KEY_FILE=./secrets/production/wechat-apiclient-key.pem
WECHAT_PAY_API_V3_KEY_FILE=./secrets/production/wechat-api-v3-key.txt
WECHAT_PAY_NOTIFY_URL=https://api.runruncampus.cn/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.runruncampus.cn/api/v1/payments/wechat/refund-notify
